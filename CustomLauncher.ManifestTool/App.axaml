<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CustomLauncher.ManifestTool.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <SolidColorBrush x:Key="WindowBrush" Color="#12151B" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#1A1E26" />
    <SolidColorBrush x:Key="BorderBrush" Color="#2E3440" />
    <SolidColorBrush x:Key="MutedBrush" Color="#98A0AE" />
    <SolidColorBrush x:Key="AccentBrush" Color="#3D7DFF" />
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <Style Selector="Button">
      <Setter Property="Height" Value="34" />
      <Setter Property="MinWidth" Value="104" />
      <Setter Property="Padding" Value="16,0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.accent">
      <Setter Property="Height" Value="40" />
      <Setter Property="MinWidth" Value="150" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </Application.Styles>
</Application>
