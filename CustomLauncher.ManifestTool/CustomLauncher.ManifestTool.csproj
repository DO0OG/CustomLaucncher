<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CustomLauncher.Shared\CustomLauncher.Shared.csproj" />
    <!-- Lets the tests round-trip manifests through the tool's own serializer settings
         instead of re-declaring them and drifting apart. -->
    <InternalsVisibleTo Include="CustomLauncher.Tests" />
  </ItemGroup>

</Project>
