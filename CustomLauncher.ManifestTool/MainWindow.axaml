<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CustomLauncher.ManifestTool.MainWindow"
        Width="760" Height="820" MinWidth="640" MinHeight="600"
        Background="{StaticResource WindowBrush}"
        WindowStartupLocation="CenterScreen"
        Title="배포 매니페스트 생성기">
  <Grid RowDefinitions="*,Auto" Margin="20">
    <ScrollViewer Grid.Row="0">
      <StackPanel Spacing="16">

        <StackPanel Spacing="6">
          <TextBlock Classes="label" Text="서버" />
          <TextBlock Classes="hint" Text="매니페스트에 올릴 서버 목록입니다. 서버마다 모듈이 따로 관리되고, 아래 생성은 선택한 서버에만 적용됩니다." />
          <Grid ColumnDefinitions="*,Auto">
            <ListBox ItemsSource="{Binding Servers}" SelectedItem="{Binding SelectedServer}" Height="110">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Display}" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Grid.Column="1" Spacing="8" Margin="8,0,0,0">
              <Button Content="서버 추가" Click="AddServerClicked" />
              <Button Content="서버 삭제" Click="RemoveServerClicked" IsEnabled="{Binding CanDeleteServer}" />
            </StackPanel>
          </Grid>
          <Grid DataContext="{Binding SelectedServer}" ColumnDefinitions="Auto,*,Auto,*"
                RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="8" Margin="0,8,0,0">
            <TextBlock Grid.Row="0" Grid.Column="0" Classes="hint" VerticalAlignment="Center" Text="ID" />
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Id}" Watermark="예: dogs" />
            <TextBlock Grid.Row="0" Grid.Column="2" Classes="hint" VerticalAlignment="Center" Text="이름" />
            <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding Name}" />

            <TextBlock Grid.Row="1" Grid.Column="0" Classes="hint" VerticalAlignment="Center" Text="주소" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Address}" Watermark="예: play.example.com" />
            <TextBlock Grid.Row="1" Grid.Column="2" Classes="hint" VerticalAlignment="Center" Text="포트" />
            <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding Port}" />

            <TextBlock Grid.Row="2" Grid.Column="0" Classes="hint" VerticalAlignment="Center" Text="Minecraft 버전" />
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding MinecraftVersion}" Watermark="예: 1.20.1" />
            <TextBlock Grid.Row="2" Grid.Column="2" Classes="hint" VerticalAlignment="Center" Text="로더 종류" />
            <ComboBox Grid.Row="2" Grid.Column="3" HorizontalAlignment="Stretch"
                      ItemsSource="{Binding LoaderTypes}" SelectedItem="{Binding LoaderType}" />

            <TextBlock Grid.Row="3" Grid.Column="0" Classes="hint" VerticalAlignment="Center" Text="로더 버전" />
            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding LoaderVersion}" />
            <TextBlock Grid.Row="3" Grid.Column="2" Classes="hint" VerticalAlignment="Center" Text="Java 권장" />
            <TextBox Grid.Row="3" Grid.Column="3" Text="{Binding JavaRecommendedVersion}" Watermark="예: 17" />

            <TextBlock Grid.Row="4" Grid.Column="0" Classes="hint" VerticalAlignment="Center" Text="Java 최소" />
            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding JavaMinVersion}" Watermark="예: 17" />
          </Grid>
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Classes="label" Text="배포 폴더" />
          <TextBlock Classes="hint" Text="서버에 배포할 파일이 들어 있는 폴더입니다. 하위 폴더까지 전부 스캔합니다." />
          <Grid ColumnDefinitions="*,Auto">
            <TextBox Text="{Binding SourceDirectory}" Watermark="예: D:\pack" />
            <Button Grid.Column="1" Content="폴더 선택" Click="BrowseClicked" Margin="8,0,0,0" />
          </Grid>
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Classes="label" Text="다운로드 URL 형식" />
          <TextBlock Classes="hint">
            <Run Text="파일 경로가 들어갈 자리에 {path} 를 넣습니다. 예: 파일이 경로 그대로 열리면" />
            <Run Text="https://호스트/폴더/{path}, Seafile 폴더 공유면 https://호스트/d/토큰/files/?p=/{path}&amp;dl=1" />
          </TextBlock>
          <TextBox Text="{Binding UrlTemplate}"
                   Watermark="https://files.example.com/TEST/{path}"
                   FontFamily="Consolas, Menlo, monospace" />
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Classes="label" Text="저장 위치" />
          <TextBlock Classes="hint" Text="distribution.json 을 저장하고 불러오는 경로입니다." />
          <TextBox Text="{Binding OutputPath}" Watermark="예: D:\pack\distribution.json" />
        </StackPanel>

        <CheckBox IsChecked="{Binding MergeWithExisting}"
                  Content="기존 매니페스트의 설정 유지 (필수/선택 구분, 로드 순서 등)" />

        <StackPanel Spacing="6">
          <TextBlock Classes="label" Text="결과" />
          <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="1" CornerRadius="8" Padding="12" MinHeight="150">
            <TextBlock Text="{Binding Log}" TextWrapping="Wrap" FontFamily="Consolas, Menlo, monospace"
                       FontSize="12" />
          </Border>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,16,0,0">
      <TextBlock Grid.Column="0" Classes="hint" VerticalAlignment="Center"
                 Text="입력한 값은 자동으로 저장되어 다음 실행 때 그대로 남습니다." />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button Content="불러오기" Click="LoadClicked" IsEnabled="{Binding CanGenerate}" />
        <Button Content="저장" Click="SaveClicked" IsEnabled="{Binding CanGenerate}" />
        <Button Classes="accent" Content="선택한 서버의 모듈 생성"
                Click="GenerateClicked" IsEnabled="{Binding CanGenerate}" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
