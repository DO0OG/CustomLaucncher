<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CustomLauncher.Views.AboutWindow" Width="560" Height="430" Title="정보">
  <ScrollViewer>
    <StackPanel Margin="24" Spacing="12">
      <TextBlock Text="CustomLauncher 2.0" FontSize="28" />
      <TextBlock Text=".NET 8 기반 크로스플랫폼 Minecraft 런처" />
      <TextBlock Text="오픈소스 라이선스" FontSize="20" Margin="0,12,0,0" />
      <TextBlock TextWrapping="Wrap" Text="Avalonia UI (MIT)&#10;CmlLib.Core (MIT)&#10;SharpCompress (MIT)&#10;xUnit (Apache-2.0)" />
      <TextBlock TextWrapping="Wrap" Opacity="0.65" Text="배경음악 기능은 네이티브 런타임 및 라이선스 부담을 피하기 위해 제외했습니다." />
    </StackPanel>
  </ScrollViewer>
</Window>
