<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CustomLauncher.Views.JavaSettingsTab">
  <StackPanel Margin="20" Spacing="10">
    <TextBlock Text="Java 실행 파일" /><TextBox Text="{Binding Java.ExecutablePath}" Watermark="자동 검색" />
    <TextBlock Text="최소 RAM (MB)" /><NumericUpDown Value="{Binding Java.MinRamMb}" Minimum="512" Maximum="65536" Increment="256" />
    <TextBlock Text="최대 RAM (MB)" /><NumericUpDown Value="{Binding Java.MaxRamMb}" Minimum="512" Maximum="65536" Increment="256" />
    <CheckBox IsChecked="{Binding Java.AutoInstallEnabled}" Content="필요한 Java 런타임 자동 설치 허용" />
    <TextBlock Text="JVM 인자" /><TextBox Text="{Binding Java.JvmArgumentsText}" AcceptsReturn="True" Height="130" />
  </StackPanel>
</UserControl>
