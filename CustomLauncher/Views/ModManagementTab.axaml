<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CustomLauncher.Views.ModManagementTab">
  <StackPanel Margin="20" Spacing="10" DataContext="{Binding Modules}">
    <TextBlock Text="모드 관리" FontSize="20"/>
    <ListBox ItemsSource="{Binding Modules}" Height="280"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Id}"/></DataTemplate></ListBox.ItemTemplate></ListBox>
    <Button Content="업데이트 확인 및 적용" Command="{Binding RefreshCommand}"/>
  </StackPanel>
</UserControl>
