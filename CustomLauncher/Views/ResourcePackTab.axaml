<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CustomLauncher.Views.ResourcePackTab">
  <Grid Margin="4,16" RowDefinitions="Auto,*,Auto,Auto" DataContext="{Binding ResourcePacks}">
    <TextBlock Grid.Row="0" Classes="muted" Margin="0,0,0,8" TextWrapping="Wrap"
               Text="위에 있을수록 먼저 적용됩니다. 항목을 끌어서 옮기거나 ▲▼ 버튼을 쓰세요. 서버 필수 팩은 맨 위에 고정됩니다." />

    <Panel Grid.Row="1">
      <ListBox Name="PackList" ItemsSource="{Binding Packs}" SelectedItem="{Binding SelectedPack}"
               DragDrop.AllowDrop="True">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel>
              <!-- Insertion indicator: the dragged pack lands above this row. -->
              <Border Height="2" Background="{StaticResource AccentBrush}" Margin="0,0,0,2"
                      IsVisible="{Binding IsDropTarget}" />
              <Grid ColumnDefinitions="Auto,*,Auto" Height="28">
                <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled}" IsEnabled="{Binding CanDisable}"
                          Margin="0,0,4,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding FileName}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Text="필수" Classes="muted" VerticalAlignment="Center"
                           IsVisible="{Binding IsServerManaged}" />
              </Grid>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock Classes="muted" IsVisible="{Binding IsEmpty}" IsHitTestVisible="False"
                 HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                 Text="리소스팩이 없습니다.&#10;'추가'로 zip 파일을 넣어 주세요." />
    </Panel>

    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Margin="0,12,0,0">
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
        <Button Width="44" MinWidth="0" Content="▲" Command="{Binding MoveUpCommand}" ToolTip.Tip="위로" />
        <Button Width="44" MinWidth="0" Content="▼" Command="{Binding MoveDownCommand}" ToolTip.Tip="아래로" />
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
        <Button Content="추가" Command="{Binding AddCommand}" />
        <Button Content="삭제" Command="{Binding DeleteCommand}" />
        <Button Content="새로 고침" Command="{Binding RefreshCommand}" />
        <Button Classes="accent" Height="34" MinWidth="130" Content="적용" Command="{Binding ApplyCommand}" />
      </StackPanel>
    </Grid>

    <TextBlock Grid.Row="3" Text="{Binding Message}" Classes="muted" TextWrapping="Wrap"
               Margin="0,10,0,0" MinHeight="16" />
  </Grid>
</UserControl>
