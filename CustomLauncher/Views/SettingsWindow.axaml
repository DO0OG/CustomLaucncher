<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CustomLauncher.Views"
        x:Class="CustomLauncher.Views.SettingsWindow"
        Width="760" Height="560" MinWidth="620" MinHeight="460"
        Title="런처 설정">
  <Grid RowDefinitions="*,Auto" Margin="18">
    <TabControl>
      <TabItem Header="일반">
        <StackPanel Margin="20" Spacing="12">
          <TextBlock Text="게임 설치 경로" />
          <Grid ColumnDefinitions="*,Auto">
            <TextBox Text="{Binding InstallPath}" />
            <Button Grid.Column="1" Content="찾아보기" Click="BrowseFolderClicked" Margin="8,0,0,0" />
          </Grid>
          <TextBlock Text="화면 크기" />
          <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
            <NumericUpDown Value="{Binding ResolutionWidth}" Minimum="640" Maximum="7680" />
            <NumericUpDown Grid.Column="1" Value="{Binding ResolutionHeight}" Minimum="480" Maximum="4320" />
          </Grid>
          <CheckBox IsChecked="{Binding DiscordRpcEnabled}" Content="Discord 활동 상태 사용" />
          <TextBlock Text="{Binding ValidationMessage}" Foreground="#E85D75" />
        </StackPanel>
      </TabItem>
      <TabItem Header="Java"><views:JavaSettingsTab /></TabItem>
      <TabItem Header="모드"><views:ModManagementTab /></TabItem>
      <TabItem Header="셰이더"><views:ShaderPackTab /></TabItem>
      <TabItem Header="리소스팩"><views:ResourcePackTab /></TabItem>
    </TabControl>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
      <Button Content="정보" Click="AboutClicked" />
      <Button Content="취소" Click="CancelClicked" />
      <Button Content="저장" IsDefault="True" Click="SaveClicked" />
    </StackPanel>
  </Grid>
</Window>
